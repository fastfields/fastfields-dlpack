# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# Compiled extension modules (built in-place by setup.py)
/fastfields/dlpack/_core*.so
/fastfields/dlpack/_core*.pyd

# Shipped native libs are generated at build time; do NOT track them.
# (The lib/ directory convention itself is documented and recreated by setup.py.)
/fastfields/dlpack/lib/

# The fastfields-lib C++ source tree. Not tracked here (and no longer a
# submodule): setup.py fetches the commit pinned in fastfields-lib.sha into
# this path at build time, or a contributor points $FASTFIELDS_DIR at their own
# checkout instead. Leaving it untracked-but-not-ignored would also make
# versioningit read the working tree as dirty on every build.
/_fastfields_lib/
/_fastfields_lib.fetching/

# versioningit-generated version file
/fastfields/dlpack/_version.py

# zensical build output
site/
